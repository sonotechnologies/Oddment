// Oddment — store schema.
// Money is stored in pence as Int throughout; never floats.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  WOMEN
  MEN
  ACCESSORIES
}

enum Fulfilment {
  DELIVERY
  COLLECTION
}

enum DeliveryMethod {
  STANDARD
  NEXT_DAY
  INTERNATIONAL
  COLLECTION
}

enum OrderStatus {
  PENDING
  READY_FOR_COLLECTION
  COLLECTED
  SHIPPED
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  category        Category
  pricePence      Int
  description     String
  staffNote       String?
  staffNoteAuthor String?
  isNewIn         Boolean       @default(false)
  isStaffPick     Boolean       @default(false)
  imageQuery      String
  position        Int
  createdAt       DateTime      @default(now())
  sizes           ProductSize[]
  orderItems      OrderItem[]

  @@index([category])
  @@index([position])
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  stock     Int     @default(0)
  position  Int

  @@unique([productId, label])
  @@index([productId])
}

model Order {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  ref            String         @unique
  customerName   String
  email          String
  phone          String
  fulfilment     Fulfilment
  deliveryMethod DeliveryMethod
  addressLine    String?
  city           String?
  postcode       String?
  country        String?
  subtotalPence  Int
  deliveryPence  Int
  totalPence     Int
  status         OrderStatus    @default(PENDING)
  createdAt      DateTime       @default(now())
  items          OrderItem[]

  @@index([status])
  @@index([fulfilment])
  @@index([createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  productSlug    String
  sizeLabel      String
  unitPricePence Int
  quantity       Int

  @@index([orderId])
}
