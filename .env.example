# Copy to .env.local and fill in. Never commit .env.local.

# Pexels API key — used ONLY by scripts/fetch-images.ts (npm run fetch-images).
# Never referenced by any page, component, API route or client bundle.
# Get one free at https://www.pexels.com/api/
PEXELS_API_KEY=

# Postgres connection string.
# Local dev:  postgresql://postgres@127.0.0.1:5433/oddment
# Production: your Neon connection string (set this in the Vercel dashboard)
DATABASE_URL=

# Admin dashboard credentials.
# Generate a password hash with: npm run hash-password -- 'your-password'
# The hash is colon-separated on purpose: Next.js expands $NAME inside .env
# files, so a $-separated hash would be silently truncated.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Secret used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Shadow database, only needed to CREATE migrations locally (not to deploy).
SHADOW_DATABASE_URL=
